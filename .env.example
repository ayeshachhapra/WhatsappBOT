# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=watracker

# Gemini (Google AI Studio API key auth)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_THINKING_LEVEL=LOW
GEMINI_MAX_OUTPUT_TOKENS=8192

# Server
PORT=5000
TIMEZONE=Asia/Kolkata

# WhatsApp
WHATSAPP_AUTO_CONNECT=true
WHATSAPP_RECONNECT_ON_CONFLICT=false

# Pipeline / drafter
FOLLOWUP_LOOKBACK_HOURS=24

# Email follow-ups (Postmark inbound)
# Address always Cc'd on outbound follow-up emails so supplier "Reply All"
# replies route into Postmark and reach our /api/webhooks/inbound-email webhook.
INBOUND_CC_EMAIL=ayesha@moviant.ai
# Basic-auth credentials for the inbound webhook. Configure the same values in
# Postmark's inbound webhook URL (https://USER:PASSWORD@your-host/api/webhooks/inbound-email).
INBOUND_WEBHOOK_USER=postmark
INBOUND_WEBHOOK_PASSWORD=change-me
# Reserved for a future programmatic-send path (plus-addressing matcher).
REPLY_TO_DOMAIN=moviant.ai
REPLY_TO_LOCAL_PART=dev
